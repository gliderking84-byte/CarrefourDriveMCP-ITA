# Shell scripts and Docker files run inside Linux containers: keep LF line
# endings even on a Windows checkout (core.autocrlf would turn them to CRLF,
# and "#!/bin/sh\r" fails with "no such file or directory").
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
docker/*.json   text eol=lf
