{
  "name": "get_product",
  "description": "Fetches one product by EAN (the 'pid' on carrefour.it): name, brand, current price and list price if discounted, unit price, size, category path, lifestyle tags (e.g. 'Senza lattosio'), quantity already in the cart and product URL.",
  "parameters": {
    "type": "object",
    "properties": {
      "ean": {
        "type": "string",
        "description": "Product EAN / barcode (e.g. '8002580010945')."
      }
    },
    "required": [
      "ean"
    ]
  },
  "request": {
    "method": "GET",
    "url": "https://www.carrefour.it/on/demandware.store/Sites-carrefour-IT-Site/it_IT/Tile-Show",
    "headers": {
      "accept": "application/json, text/plain, */*",
      "x-requested-with": "XMLHttpRequest"
    },
    "query": {
      "pid": {
        "$param": "ean"
      },
      "preload": "false"
    }
  },
  "requires_auth": false,
  "response": {
    "extract": "product_grid"
  }
}
