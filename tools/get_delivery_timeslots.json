{
  "name": "get_delivery_timeslots",
  "description": "Lists the available delivery or pickup timeslots for a store and shipping method, day by day: timeslot ID, start and end, and whether it is an 'eco' (sustainable) slot or already reserved. Pass the start/end values unchanged to reserve_delivery_timeslot.",
  "parameters": {
    "type": "object",
    "properties": {
      "storeId": {
        "type": "string",
        "description": "Carrefour store ID (e.g. '1234'), as returned by find_stores or get_delivery_selection."
      },
      "shipmentId": {
        "type": "string",
        "description": "Shipping method: 'delivery', 'pickup_in_store' or 'drive'."
      },
      "cap": {
        "type": "string",
        "description": "Postal code (CAP) of the delivery address."
      },
      "city": {
        "type": "string",
        "description": "Municipality of the delivery address."
      }
    },
    "required": [
      "storeId",
      "shipmentId",
      "cap",
      "city"
    ]
  },
  "request": {
    "method": "GET",
    "url": "https://www.carrefour.it/on/demandware.store/Sites-carrefour-IT-Site/it_IT/TimeSlotApi-GetTimeSlots",
    "headers": {
      "accept": "application/json, text/plain, */*",
      "x-requested-with": "XMLHttpRequest"
    },
    "query": {
      "storeId": {
        "$param": "storeId"
      },
      "shipmentId": {
        "$param": "shipmentId"
      },
      "cap": {
        "$param": "cap"
      },
      "city": {
        "$param": "city"
      }
    }
  },
  "requires_auth": true,
  "response": {
    "extract": "timeslots"
  }
}
